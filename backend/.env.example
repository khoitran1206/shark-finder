# Copy to backend/.env and fill in. Never commit the real file.
# Only GEMINI_API_KEY and a Postgres DATABASE_URL are secrets; everything else is optional.

# Postgres connection string (e.g. Supabase). Leave unset to use the local
# SQLite file backend/app/dev.db (see backend/app/database.py).
DATABASE_URL=

# Google Gemini API key. Needed when a firm records a pitch (read on first use).
GEMINI_API_KEY=

# --- Optional (defaults shown) ---
# GEMINI_MODEL=gemini-2.5-flash
# WHISPER_SIZE=small
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cognito pool used to verify login tokens. Must match frontend VITE_COGNITO_* values.
# COGNITO_REGION=us-east-2
# COGNITO_USER_POOL_ID=us-east-2_PhoO99PTx
# COGNITO_CLIENT_ID=3ipsjhg4ulpgbjfmb6nabvuml7
